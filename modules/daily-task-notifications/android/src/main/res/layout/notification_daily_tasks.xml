<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="#111111"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingTop="14dp"
  android:paddingEnd="16dp"
  android:paddingBottom="14dp">

  <TextView
    android:id="@+id/notification_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="#FFFFFF"
    android:textSize="15sp"
    android:textStyle="bold" />

  <LinearLayout
    android:id="@+id/task_row_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/task_icon_1"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="Complete task"
      android:src="@drawable/ic_notification_circle" />

    <TextView
      android:id="@+id/task_text_1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#F5F5F5"
      android:textSize="14sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/task_row_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/task_icon_2"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="Complete task"
      android:src="@drawable/ic_notification_circle" />

    <TextView
      android:id="@+id/task_text_2"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#F5F5F5"
      android:textSize="14sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/task_row_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/task_icon_3"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="Complete task"
      android:src="@drawable/ic_notification_circle" />

    <TextView
      android:id="@+id/task_text_3"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#F5F5F5"
      android:textSize="14sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/more_text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:textColor="#B8B8B8"
    android:textSize="13sp"
    android:visibility="gone" />
</LinearLayout>
